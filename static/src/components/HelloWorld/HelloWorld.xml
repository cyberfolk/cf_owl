<templates>
    <t t-name="HelloWorld">
        <div>
            <div>
                <span>Ciao,</span>
                <t t-esc="store.name"/>!
<!--                <t t-esc="state.name"/>!-->
                <!--      <input t-on-input="updateName($event.target.value)" placeholder="Inserisci il tuo nome"/>-->
                <p>Counter:
                    <t t-esc="state.value"/>
                </p>
            </div>
            <div>
                <button class="btn btn-primary" t-on-click="increment">Increment</button>
                <button class="btn" t-attf-class="{{ (state.is_primary) ? 'btn-primary' : 'btn-secondary' }}" t-on-click="toggle_is_primary">Toggle</button>
            </div>
            <div>
                <t t-foreach="store.list" t-as="item" t-key="item" t-esc="item"/>
            </div>
            <div>
                <t t-esc="store"/>
            </div>
        </div>
    </t>
</templates>
