<templates>
    <t t-name="CounterClick">
        <div class="p-3 m-3 bg-warning rounded">
            <h2>CounterClick</h2>
            <div class="input-group mb-3">
                <div class="input-group-text">
                    <b>Counter</b>
                </div>
                <div class="input-group-text bg-light" t-esc="state.counter"/>
                <button class="btn btn-primary"
                        t-on-click="increment">
                    <span>Increment</span>
                </button>
            </div>
        </div>
    </t>
</templates>
